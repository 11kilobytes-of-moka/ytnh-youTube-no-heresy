{
  "manifest_version": 3,
  "name": "YouTube No Heresy",
  "version": "0.1.0",
  "description": "They made a mistake that I'm going to fix myself.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "YouTube No Heresy"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ]
}
